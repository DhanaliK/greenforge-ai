# GreenForge AI — Environment Variables
# Copy this file to .env and fill in your credentials

# ---- IBM Granite / watsonx.ai ----
# Leave blank to use local fallback (Demo mode)
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_SERVICE_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ---- App ----
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./greenforge.db

# ---- Sustainability defaults (configurable in UI) ----
DEFAULT_CPU_TDP_WATTS=95.0
DEFAULT_GRID_CARBON_INTENSITY=475.0
DEFAULT_PUE=1.5
DEFAULT_CPU_UTILIZATION=0.5

# ---- Benchmark ----
BENCHMARK_TIMEOUT=30
BENCHMARK_RUNS=5
MAX_CODE_SIZE_KB=512
